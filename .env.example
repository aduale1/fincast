# Copy this file to apps/api/.env and fill in real values.
# Never commit the real .env file: it is listed in .gitignore.

# Local Postgres connection string (see docs/DEVELOPMENT.md).
DATABASE_URL=postgres://fincast:fincast@localhost:5432/fincast

# Port the API listens on.
PORT=3000

# development | test | production
NODE_ENV=development
